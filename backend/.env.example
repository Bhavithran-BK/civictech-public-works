# Environment configuration for DigOnce Backend API
PROJECT_NAME="DigOnce Public Works Coordination API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Supabase Auth and Database Settings
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Conflict & Health Scoring Engine Defaults
CONFLICT_BUFFER_METERS=50.0
RECENT_DIG_LOOKBACK_DAYS=90
AVOIDABLE_COST_PERCENTAGE=0.35
